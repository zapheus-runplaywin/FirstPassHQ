{
  "name": "thunderapp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/jest-runner": "10.1.1",
    "@supabase/supabase-js": "^2.118.0",
    "aes-js": "^3.1.2",
    "expo": "~57.0.31",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "ical.js": "^2.2.1",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "13.16.2",
    "react-native-worklets": "0.10.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "30.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "fast-check": "4.10.2",
    "jest": "~30.5.2",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:sql": "scripts/run-sql-tests.sh",
    "test:mutation": "stryker run",
    "e2e:build": "EXPO_PUBLIC_SUPABASE_URL=https://example.supabase.co EXPO_PUBLIC_SUPABASE_ANON_KEY=x EXPO_OFFLINE=1 expo export -p web --clear --output-dir e2e/web-build",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/supabase/(?!functions/[^/]+/__tests__/)",
      "/e2e/",
      "<rootDir>/.stryker-tmp/",
      "<rootDir>/.claude/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.stryker-tmp/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/__tests__/**"
    ],
    "coverageReporters": [
      "text-summary",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 91,
        "branches": 85,
        "functions": 90,
        "lines": 91
      }
    },
    "workerIdleMemoryLimit": "1GB"
  }
}
