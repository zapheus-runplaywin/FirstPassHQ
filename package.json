{
  "name": "thunderapp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "dependencies": {
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@firstpass/engine": "0.2.1",
    "@firstpass/schema": "0.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/jest-runner": "10.1.1",
    "@supabase/supabase-js": "^2.119.2",
    "aes-js": "^3.1.2",
    "expo": "~58.0.26",
    "expo-apple-authentication": "~58.0.3",
    "expo-application": "~58.1.2",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.8",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.12",
    "expo-font": "~58.0.10",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.1.0",
    "ical.js": "^2.2.1",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.2",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "fast-check": "4.11.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:sql": "scripts/run-sql-tests.sh",
    "test:mutation": "stryker run",
    "e2e:build": "EXPO_PUBLIC_SUPABASE_URL=https://example.supabase.co EXPO_PUBLIC_SUPABASE_ANON_KEY=x EXPO_OFFLINE=1 expo export -p web --clear --output-dir e2e/web-build",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "eas-build-pre-install": "node scripts/check-build-settings.js"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.after-env.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/supabase/(?!functions/[^/]+/__tests__/)",
      "/e2e/",
      "<rootDir>/.stryker-tmp/",
      "<rootDir>/.claude/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.stryker-tmp/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/__tests__/**"
    ],
    "coverageReporters": [
      "text-summary",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 91,
        "branches": 85,
        "functions": 90,
        "lines": 91
      }
    },
    "workerIdleMemoryLimit": "1GB"
  },
  "overrides": {
    "jsdom": "^29.1.1",
    "qs": "^6.17.1",
    "test-exclude": {
      ".": "^8.0.0",
      "glob": "^14.0.6",
      "minimatch": "^11.0.9"
    },
    "glob": "^14.0.6",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.9",
    "node-forge": "^1.4.3"
  }
}
