# The TEST Supabase project (docs/environments.md), from its dashboard >
# Project Settings > API. Installed builds get the live project's values from EAS.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: the club code and name for this project. Without them it's THUNDER,
# West Coast Thunder. See docs/new-club-setup.md.
# EXPO_PUBLIC_CLUB_CODE=THUNDER
# EXPO_PUBLIC_CLUB_NAME=West Coast Thunder
