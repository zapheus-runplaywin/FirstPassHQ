# The TEST Supabase project (docs/environments.md), from its dashboard >
# Project Settings > API. Installed builds get the live project's values from EAS.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: the club code and name for this project. Without them it's THUNDER,
# West Coast Thunder. See docs/new-club-setup.md.
# EXPO_PUBLIC_CLUB_CODE=THUNDER
# EXPO_PUBLIC_CLUB_NAME=West Coast Thunder

# Optional: up to two more test clubs for Expo Go, each with its own project.
# Never in installed builds or updates. See docs/environments.md, "More test clubs".
# EXPO_PUBLIC_TEST_CLUB_2_CODE=HAWKS
# EXPO_PUBLIC_TEST_CLUB_2_NAME=Hawks Netball Club
# EXPO_PUBLIC_TEST_CLUB_2_URL=https://second-project-ref.supabase.co
# EXPO_PUBLIC_TEST_CLUB_2_ANON_KEY=its-anon-public-key
# EXPO_PUBLIC_TEST_CLUB_3_CODE=FALCONS
# EXPO_PUBLIC_TEST_CLUB_3_NAME=Falcons Netball Club
# EXPO_PUBLIC_TEST_CLUB_3_URL=https://third-project-ref.supabase.co
# EXPO_PUBLIC_TEST_CLUB_3_ANON_KEY=its-anon-public-key
